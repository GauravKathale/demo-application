# =====================================================
# ============== Environment Variables Template
# =====================================================
# Copy this file to .env.local and fill in your values
# DO NOT commit .env files to version control
#
# Usage:
# 1. Copy this file to .env.local
# 2. Fill in your actual values
# 3. Source the file before running the application
#
# Windows (PowerShell):
#   $env:SPRING_PROFILES_ACTIVE="local"
#   # Then manually set each variable above or use a .env loader
#
# Linux/Mac (Bash):
#   source .env.local
#   export SPRING_PROFILES_ACTIVE=local

# =====================================================
# ============== Spring Profile Selection =============
# =====================================================
# Options: local (non-SSO), dev (SSO), test (SSO), prod (SSO)
SPRING_PROFILES_ACTIVE=local

# =====================================================
# ============== LOCAL ENVIRONMENT (Non-SSO)
# =====================================================
# Use these for application-local.yml profile

# Spring Security - Basic Auth
LOCAL_USERNAME=demo
LOCAL_PASSWORD=demo

# Database Configuration (H2)
LOCAL_DB_URL=jdbc:h2:file:./data/gno;TRACE_LEVEL_FILE=0;DB_CLOSE_ON_EXIT=FALSE
LOCAL_DB_USERNAME=sa
LOCAL_DB_PASSWORD=sa

LOCAL_DB_ENGINE_URL=jdbc:h2:file:./data/engine;TRACE_LEVEL_FILE=0;DB_CLOSE_ON_EXIT=FALSE
LOCAL_DB_ENGINE_USERNAME=sa
LOCAL_DB_ENGINE_PASSWORD=sa

# Azure AD (Optional for local, can be left as defaults)
LOCAL_AZURE_TENANT_ID=local-tenant-id
LOCAL_AZURE_CLIENT_ID=local-client-id
LOCAL_AZURE_CLIENT_SECRET=local-client-secret
LOCAL_AZURE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/azure

# JIRA Configuration
LOCAL_JIRA_EMAIL=local@example.com
LOCAL_JIRA_BASE_URL=http://localhost:8080/jira
LOCAL_JIRA_API_TOKEN=local-token

# =====================================================
# ============== DEVELOPMENT ENVIRONMENT (SSO)
# =====================================================
# Use these for application-dev.yml profile

# Azure AD Configuration (REQUIRED for SSO)
DEV_AZURE_TENANT_ID=your-dev-tenant-id
DEV_AZURE_CLIENT_ID=your-dev-client-id
DEV_AZURE_CLIENT_SECRET=your-dev-client-secret
DEV_AZURE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/azure

# Database Configuration (H2)
DEV_DB_URL=jdbc:h2:file:./data/gno;TRACE_LEVEL_FILE=0;DB_CLOSE_ON_EXIT=FALSE
DEV_DB_USERNAME=sa
DEV_DB_PASSWORD=sa

DEV_DB_ENGINE_URL=jdbc:h2:file:./data/engine;TRACE_LEVEL_FILE=0;DB_CLOSE_ON_EXIT=FALSE
DEV_DB_ENGINE_USERNAME=sa
DEV_DB_ENGINE_PASSWORD=sa

# JIRA Configuration
DEV_JIRA_EMAIL=dev@example.com
DEV_JIRA_BASE_URL=https://dev-jira.atlassian.net
DEV_JIRA_API_TOKEN=your-dev-jira-api-token

# =====================================================
# ============== TEST ENVIRONMENT (SSO)
# =====================================================
# Use these for application-test.yml profile

# Azure AD Configuration (REQUIRED for SSO)
TEST_AZURE_TENANT_ID=your-test-tenant-id
TEST_AZURE_CLIENT_ID=your-test-client-id
TEST_AZURE_CLIENT_SECRET=your-test-client-secret
TEST_AZURE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/azure

# Database Configuration (H2 - Test Instance)
TEST_DB_URL=jdbc:h2:file:./data/gno-test;TRACE_LEVEL_FILE=0;DB_CLOSE_ON_EXIT=FALSE
TEST_DB_USERNAME=sa
TEST_DB_PASSWORD=sa

TEST_DB_ENGINE_URL=jdbc:h2:file:./data/engine-test;TRACE_LEVEL_FILE=0;DB_CLOSE_ON_EXIT=FALSE
TEST_DB_ENGINE_USERNAME=sa
TEST_DB_ENGINE_PASSWORD=sa

# JIRA Configuration
TEST_JIRA_EMAIL=test@example.com
TEST_JIRA_BASE_URL=https://test-jira.atlassian.net
TEST_JIRA_API_TOKEN=your-test-jira-api-token

# =====================================================
# ============== PRODUCTION ENVIRONMENT (SSO)
# =====================================================
# Use these for application-prod.yml profile

# Azure AD Configuration (REQUIRED for SSO)
PROD_AZURE_TENANT_ID=your-prod-tenant-id
PROD_AZURE_CLIENT_ID=your-prod-client-id
PROD_AZURE_CLIENT_SECRET=your-prod-client-secret
PROD_AZURE_REDIRECT_URI=https://prod.example.com/login/oauth2/code/azure

# Database Configuration (PostgreSQL - Production)
PROD_DB_URL=jdbc:postgresql://prod-db-host:5432/gno
PROD_DB_USERNAME=gno_prod_user
PROD_DB_PASSWORD=your-secure-prod-password

PROD_DB_ENGINE_URL=jdbc:postgresql://prod-db-host:5432/camunda
PROD_DB_ENGINE_USERNAME=camunda_prod_user
PROD_DB_ENGINE_PASSWORD=your-secure-engine-password

# JIRA Configuration
PROD_JIRA_EMAIL=prod@example.com
PROD_JIRA_BASE_URL=https://prod-jira.atlassian.net
PROD_JIRA_API_TOKEN=your-prod-jira-api-token

# =====================================================
# ============== GENERIC/FALLBACK VARIABLES
# =====================================================
# These are used if environment-specific variables are not set
# Useful for shared configuration across environments

AZURE_TENANT_ID=your-fallback-tenant-id
AZURE_CLIENT_ID=your-fallback-client-id
AZURE_CLIENT_SECRET=your-fallback-client-secret
AZURE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/azure

DB_URL=jdbc:h2:file:./data/gno;TRACE_LEVEL_FILE=0;DB_CLOSE_ON_EXIT=FALSE
DB_USERNAME=sa
DB_PASSWORD=sa

DB_ENGINE_URL=jdbc:h2:file:./data/engine;TRACE_LEVEL_FILE=0;DB_CLOSE_ON_EXIT=FALSE
DB_ENGINE_USERNAME=sa
DB_ENGINE_PASSWORD=sa

JIRA_EMAIL=admin@example.com
JIRA_BASE_URL=https://jira.atlassian.net
JIRA_API_TOKEN=your-jira-api-token

# =====================================================
# ============== OPTIONAL JVM SETTINGS
# =====================================================
# Uncomment and adjust as needed for your environment

# JAVA_OPTS=-Xmx2048m -Xms1024m -XX:+UseG1GC
# SPRING_APPLICATION_NAME=gno
# SERVER_PORT=8080
# SERVER_SERVLET_CONTEXT_PATH=/gno
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics

# =====================================================
# ============== NOTES FOR CONFIGURATION
# =====================================================
#
# 1. LOCAL (Non-SSO):
#    - No Azure AD credentials required
#    - Uses basic username/password authentication
#    - Best for local development without Azure integration
#
# 2. DEV (SSO Enabled):
#    - Azure AD integration enabled
#    - Use dev Azure AD application credentials
#    - H2 database for development
#
# 3. TEST (SSO Enabled):
#    - Azure AD integration enabled
#    - Use test Azure AD application credentials
#    - Separate H2 database instance (gno-test)
#    - Reduced logging for test output clarity
#
# 4. PROD (SSO Enabled):
#    - Azure AD integration enabled
#    - Use prod Azure AD application credentials
#    - PostgreSQL database (external)
#    - Minimal logging
#    - Schema validation only (no auto-updates)
#
# 5. AZURE AD SETUP:
#    - Register separate Azure AD apps for each environment
#    - Each app needs: Tenant ID, Client ID, Client Secret
#    - Configure correct redirect URIs for each environment
#    - Grant API permissions for Microsoft Graph
#
# 6. SECURITY BEST PRACTICES:
#    - Never commit actual credentials to version control
#    - Use .env.local for local development (added to .gitignore)
#    - Use secure environment variables in CI/CD pipelines
#    - Rotate credentials regularly
#    - Use strong passwords/secrets
#    - Enable MFA on Azure AD accounts

