    <bpmn:serviceTask id="Activity_1swqsi0" name="Send Update for SLA breached" camunda:asyncBefore="true" camunda:asyncAfter="true" camunda:delegateExpression="${addComment}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="message">SLA has breached for this ticket, it will be automatically closed now.</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0tvw5kx</bpmn:incoming>
      <bpmn:outgoing>Flow_1inft4h</bpmn:outgoing>
    </bpmn:serviceTask>
