      <bpmn:outgoing>Flow_1pf43bv</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="Event_0o0vjdg" name="SLA" attachedToRef="Activity_0g0235u">
      <bpmn:outgoing>Flow_0tvw5kx</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0sjmp7n">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${sla_date}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:scriptTask id="Activity_InitiateAdhoc" name="Extract Priority" scriptFormat="groovy">
      <bpmn:incoming>Flow_048nd6w</bpmn:incoming>
      <bpmn:outgoing>Flow_0crbz0t</bpmn:outgoing>
      <bpmn:script>ticket_description = execution.getVariable("ticket_description")
def description = ticket_description ? ticket_description.toString() : ""

def priorityMatch = description =~ /(?im)^\s*Priority\s*:\s*(\d+)\s*$/
def priority = priorityMatch.find() ? priorityMatch.group(1)?.trim()?.toInteger() : 1

execution.setVariable("priority", priority)

def list
if (priority &gt;= 1 &amp;&amp; priority &lt;= 5) {
  list = ["Activity_1_1"]
} else if (priority &gt; 5 &amp;&amp; priority &lt;= 10) {
  list = ["Activity_1_1", "Activity_1_2"]
} else {
  list = ["Activity_1_1"]
}

execution.setVariable("taskList", list)</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:adHocSubProcess id="Activity_19pd2yt">
      <bpmn:extensionElements>
        <kramax:properties>
          <kramax:property name="activeTasksCollection" value="${taskList}" />
        </kramax:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0crbz0t</bpmn:incoming>
      <bpmn:outgoing>Flow_0tjhty2</bpmn:outgoing>
      <bpmn:serviceTask id="Activity_1_1" name="Service Task" camunda:delegateExpression="${sout}" />
      <bpmn:userTask id="Activity_1_2" name="User Task" />
    </bpmn:adHocSubProcess>
    <bpmn:sequenceFlow id="Flow_0crbz0t" sourceRef="Activity_InitiateAdhoc" targetRef="Activity_19pd2yt" />
    <bpmn:sequenceFlow id="Flow_0tjhty2" sourceRef="Activity_19pd2yt" targetRef="Activity_0g0235u" />
  </bpmn:process>
