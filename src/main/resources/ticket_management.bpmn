    <bpmn:scriptTask id="Activity_0z8c3vo" name="Calculate SLA Date" camunda:asyncBefore="true" camunda:asyncAfter="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_0cq26m1</bpmn:incoming>
      <bpmn:outgoing>Flow_1i4gfnv</bpmn:outgoing>
      <bpmn:script>import groovy.time.TimeCategory
dmn_op = execution.getVariable("dmn_output")
assigneeName = dmn_op.get("assigneeName")
sla = dmn_op.get("sla")

def date = new Date()
use(TimeCategory) {

 def newDate = date + sla.minutes
    execution.setVariable("sla_date", newDate)
}

execution.setVariable("assigneeName", assigneeName)

// Create a date  with current time + sla
// def date = new Date() + sla





</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:businessRuleTask id="Activity_1uxjkt1" name="Ticket Asignee" camunda:asyncBefore="true" camunda:asyncAfter="true" camunda:resultVariable="dmn_output" camunda:decisionRef="DMN_get_assgnee_and_sla" camunda:mapDecisionResult="singleResult">
      <bpmn:incoming>Flow_1mec9pu</bpmn:incoming>
      <bpmn:outgoing>Flow_0cq26m1</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:scriptTask id="Activity_0izq06b" name="Extract Assignee area and NE" camunda:asyncBefore="true" camunda:asyncAfter="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_1ialaxq</bpmn:incoming>
      <bpmn:outgoing>Flow_0zi66y7</bpmn:outgoing>
      <bpmn:script>ticket_description = execution.getVariable("ticket_description")
def description = ticket_description ? ticket_description.toString() : ""

// Accept both "Network Element" and "Network Element Type" labels, case-insensitive.
def assigneeMatch = description =~ /(?im)^\s*Assignee\s*Area\s*:\s*(.+)\s*$/
def neMatch = description =~ /(?im)^\s*Network\s*Element(?:\s*Type)?\s*:\s*(.+)\s*$/

def assignee_area = assigneeMatch.find() ? assigneeMatch.group(1)?.trim() : null
def ne_type = neMatch.find() ? neMatch.group(1)?.trim() : null

execution.setVariable("assigneeArea", assignee_area)
execution.setVariable("neType", ne_type)</bpmn:script>
    </bpmn:scriptTask>
