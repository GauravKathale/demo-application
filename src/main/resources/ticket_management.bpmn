      <bpmn:incoming>Flow_0j2nmfq</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_0gc1gcm">
      <bpmn:incoming>Flow_1pf43bv</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="Activity_0g0235u" name="Monitor Ticket" calledElement="monitor_ticket">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
