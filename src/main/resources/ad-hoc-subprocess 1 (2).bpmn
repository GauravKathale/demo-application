<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:kramax="http://kramax.vodafone.org/schema/1.0/bpmn" xmlns:modeler="http://kramax.vodafone.org/schema/modeler/1.0" id="Definitions_0i21ila" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Kramax Platform" modeler:executionPlatformVersion="3.1.0">
  <bpmn:process id="ad-hoc-subprocess" name="Ad Hoc Subprocess" isExecutable="true" camunda:historyTimeToLive="40">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_1fapf6i</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1fapf6i" sourceRef="StartEvent_1" targetRef="Activity_InitiateAdhoc" />
    <bpmn:scriptTask id="Activity_InitiateAdhoc" name="initiate adhoc sub process" scriptFormat="groovy">
      <bpmn:incoming>Flow_1fapf6i</bpmn:incoming>
      <bpmn:outgoing>Flow_ScriptToAdhoc</bpmn:outgoing>
      <bpmn:script>var priority = 9;
execution.setVariable("priority", priority);
var list;
if (priority &gt;= 1 &amp;&amp; priority &lt;= 5) {
  list = ["Activity_1_1"];
} else if (priority &gt;= 6 &amp;&amp; priority &lt;= 10) {
  list = ["Activity_1_1", "Activity_1_2"];
}
execution.setVariable("taskList", list);</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_ScriptToAdhoc" sourceRef="Activity_InitiateAdhoc" targetRef="Activity_19pd2yt" />
    <bpmn:adHocSubProcess id="Activity_19pd2yt">
      <bpmn:extensionElements>
        <kramax:properties>
          <kramax:property name="activeTasksCollection" value="${taskList}" />
        </kramax:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ScriptToAdhoc</bpmn:incoming>
      <bpmn:outgoing>Flow_01ci65a</bpmn:outgoing>
      <bpmn:serviceTask id="Activity_1_1" name="Service Task" camunda:delegateExpression="${sout}" />
      <bpmn:userTask id="Activity_1_2" name="User Task" />
    </bpmn:adHocSubProcess>
    <bpmn:endEvent id="Event_0flj60i">
      <bpmn:incoming>Flow_01ci65a</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01ci65a" sourceRef="Activity_19pd2yt" targetRef="Event_0flj60i" />
  </bpmn:process>
