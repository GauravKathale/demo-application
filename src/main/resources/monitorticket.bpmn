<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_monitor_ticket" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.21.0">
  <bpmn:process id="monitor_ticket" name="Monitor Ticket" isExecutable="true" camunda:historyTimeToLive="2">
    <bpmn:startEvent id="Event_00nii15" name="Start">
      <bpmn:outgoing>Flow_1r617qj</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_12q08ru">
      <bpmn:incoming>Flow_1r617qj</bpmn:incoming>
      <bpmn:incoming>Flow_18qtb45</bpmn:incoming>
      <bpmn:outgoing>Flow_0aioboy</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_0d9x1ur" name="Check Ticket Status" camunda:asyncBefore="true" camunda:asyncAfter="true" camunda:delegateExpression="${getTicketStatus}">
      <bpmn:incoming>Flow_0aioboy</bpmn:incoming>
      <bpmn:outgoing>Flow_0om04c2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_0jm09gs" name="Status?" default="Flow_1mwzr5g">
      <bpmn:incoming>Flow_0om04c2</bpmn:incoming>
      <bpmn:outgoing>Flow_1mwzr5g</bpmn:outgoing>
      <bpmn:outgoing>Flow_1rl73vs</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_0vxhk1r" name="Wait 1 min">
      <bpmn:incoming>Flow_1mwzr5g</bpmn:incoming>
      <bpmn:outgoing>Flow_18qtb45</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0b085h0">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="Event_0qqucxk" name="End">
      <bpmn:incoming>Flow_1rl73vs</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1r617qj" sourceRef="Event_00nii15" targetRef="Gateway_12q08ru" />
    <bpmn:sequenceFlow id="Flow_0aioboy" sourceRef="Gateway_12q08ru" targetRef="Activity_0d9x1ur" />
    <bpmn:sequenceFlow id="Flow_0om04c2" sourceRef="Activity_0d9x1ur" targetRef="Gateway_0jm09gs" />
    <bpmn:sequenceFlow id="Flow_1mwzr5g" name="Open" sourceRef="Gateway_0jm09gs" targetRef="Event_0vxhk1r" />
    <bpmn:sequenceFlow id="Flow_18qtb45" sourceRef="Event_0vxhk1r" targetRef="Gateway_12q08ru" />
    <bpmn:sequenceFlow id="Flow_1rl73vs" name="Done" sourceRef="Gateway_0jm09gs" targetRef="Event_0qqucxk">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ticketStatus == "Done" || ticketStatus == "DONE" || ticketStatus == "41"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:textAnnotation id="TextAnnotation_1monitor">
      <bpmn:text>Called from ticket_management.
Business key = Jira issueId.
Sets: ticketStatus</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1monitor" associationDirection="None" sourceRef="Activity_0d9x1ur" targetRef="TextAnnotation_1monitor" />
  </bpmn:process>
