		<dependency>
			<groupId>org.codehaus.groovy</groupId>
			<artifactId>groovy-jsr223</artifactId>
			<version>3.0.25</version>
			<scope>runtime</scope>
		</dependency>
        <!-- Camunda External Task Client -->
        <dependency>
            <groupId>org.vodafone.kramax.bpm</groupId>
            <artifactId>kramax-external-task-client</artifactId>
            <version>3.1.0-SNAPSHOT</version>
        </dependency>
		<dependency>
			<groupId>org.vodafone.kramax.bpm.extension</groupId>
			<artifactId>kramax-entra-identity-4</artifactId>
			<version>1.2.0-SNAPSHOT</version>
		</dependency>
		<!--&lt;!&ndash; Spring Security for basic auth and SSO &ndash;&gt;
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		&lt;!&ndash; OAuth2 Client for SSO &ndash;&gt;
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-client</artifactId>
		</dependency>-->
