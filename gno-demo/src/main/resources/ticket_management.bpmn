    <bpmn:scriptTask id="Activity_02v0lfc" name="Get Network element information" scriptFormat="groovy">
      <bpmn:incoming>Flow_0zi66y7</bpmn:incoming>
      <bpmn:outgoing>Flow_1w34qy7</bpmn:outgoing>
      <bpmn:script>// import java.net.Proxy.Type
// import groovy.json.JsonSlurper

def ne = execution.getVariable('ne')
url = "http://localhost:9090/api/data/getData"
def post = null

post = new URL(url).openConnection()
def body = '''{}'''

post.setRequestMethod("GET")
post.setDoOutput(true)
post.setRequestProperty("Accept", "application/json")
post.setRequestProperty("Content-Type", "application/json")
// post.setRequestProperty("Authorization", jira_authorizarion)
// post.getOutputStream().write(body.getBytes("UTF-8"));

def postRC = post.getResponseCode();

execution.setVariable('response_code', postRC)

if(postRC == 201 || postRC == 200){
    response = post.getInputStream().getText()
    // def jsonSlurper = new JsonSlurper()
    // def response_json = jsonSlurper.parseText(response)

    execution.setVariable('db_response', response)
}else{
    response = post.getErrorStream().getText()
    execution.setVariable('response', response)
    execution.setVariable('is_error', true)
}</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Activity_0z8c3vo" name="Calculate SLA Date" camunda:asyncBefore="true" camunda:asyncAfter="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_0cq26m1</bpmn:incoming>
      <bpmn:outgoing>Flow_1i4gfnv</bpmn:outgoing>
      <bpmn:script>import groovy.time.TimeCategory
dmn_op = execution.getVariable("dmn_output")
assigneeName = dmn_op.get("assigneeName")
sla = dmn_op.get("sla")

def date = new Date()
use(TimeCategory) {
    def newDate = date + sla.days
    execution.setVariable("sla_date", newDate)
}

execution.setVariable("assigneeName", assigneeName)

// Create a date  with current time + sla
// def date = new Date() + sla





</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Activity_0izq06b" name="Extract Assignee area and Network element" camunda:asyncBefore="true" camunda:asyncAfter="true" scriptFormat="groovy">
      <bpmn:incoming>Flow_1e9x9j9</bpmn:incoming>
      <bpmn:outgoing>Flow_0zi66y7</bpmn:outgoing>
      <bpmn:script>ticket_description = execution.getVariable("ticket_description")
// Extract the value of Assignee Area and Network Element from the ticket description
def assignee_area = ticket_description.find(/Assignee Area: (.*)\s/) { match, area -&gt; area }
def ne_type = ticket_description.find(/Network Element Type: (.*)/) { match, element -&gt; element }

def ne = ticket_description.find(/Network Element: (.*)/) { match, element -&gt; element }

assignee_area = assignee_area ? assignee_area.trim() : assignee_area
ne_type = ne_type ? ne_type.trim() : ne_type
ne = ne ? ne.trim() : ne

execution.setVariable("assigneeArea", assignee_area)
execution.setVariable("neType", ne_type)
execution.setVariable("ne", ne)</bpmn:script>
    </bpmn:scriptTask>
